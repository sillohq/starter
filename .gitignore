# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Environments
.venv/
venv/
.env
.env.local
.env.*.local

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# Application data — the directories are tracked, their contents are not.
storage/logs/*
storage/cache/*
storage/temp/*
storage/app/*
!storage/**/.gitkeep
*.db
*.sqlite3

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# The local database, including SQLite's write-ahead log and shared-memory
# files. Committing those leaves a clone with a WAL referring to a database
# that is not there, which SQLite reports as "disk I/O error".
storage/*.db
storage/*.db-shm
storage/*.db-wal
