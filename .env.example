# Starter environment.
#
# Copy to .env and adjust. Never commit .env — it is gitignored.

# --- Application ---
APP_NAME=Starter
APP_ENV=local
DEBUG=true
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
# Signs sessions and cookies. `make setup` replaces this placeholder with a
# fresh key; generate one per environment with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate-me

# --- Database ---
DATABASE_URL=sqlite://storage/starter.db
DB_POOL_SIZE=5
DB_ECHO=false

# --- Sessions ---
SESSION_COOKIE_NAME=session_id
SESSION_LIFETIME=86400

# --- Admin ---
ADMIN_ENABLED=true
ADMIN_PREFIX=/admin

# --- Security ---
CORS_ALLOW_ORIGINS=http://localhost:5173
