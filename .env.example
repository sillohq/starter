# Starter environment.
#
# Copy to .env and adjust. Never commit .env — it is gitignored.

# --- Application ---
APP_NAME=Starter
APP_ENV=local
DEBUG=true
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
# Signs sessions and cookies. Generate a fresh one per environment.
SECRET_KEY=-ihJZ22Tce-IoZ-3QeQwGREQyUg998fL2hdIbefe9Uf9IvlMc9

# --- Database ---
DATABASE_URL=sqlite://storage/starter.db
DB_POOL_SIZE=5
DB_ECHO=false

# --- Sessions ---
SESSION_COOKIE_NAME=session_id
SESSION_LIFETIME=86400

# --- Admin ---
ADMIN_ENABLED=true
ADMIN_PREFIX=/admin

# --- Security ---
CORS_ALLOW_ORIGINS=http://localhost:5173
